{
  "image" : "ghcr.io/garrickwelsh/rust-devcontainer:latest",
  // "build": { "dockerfile": "Dockerfile" },
  // "features": {
    // "ghcr.io/devcontainers/features/git:1": {},
    // "ghcr.io/devcontainers/features/docker-from-docker": {
    //   "moby": true
    // },
  // },
  "remoteEnv": {
    "PODMAN_USERNS": "keep-id"
  },
  "containerUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "bierner.markdown-mermaid",
        "bpruitt-goddard.mermaid-markdown-syntax-highlighting",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "ms-azuretools.vscode-docker",
        "ms-dotnettools.vscodeintellicode-csharp",
        "mutantdino.resourcemonitor",
        "tomoyukim.vscode-mermaid-editor"
      ],
    }
  },
  "mounts" : [
    "source=${localEnv:HOME}/.config/helix,target=/home/vscode/.config/helix,type=bind"
  ],
  // "postCreateCommand": "",
  "postStartCommand": "rustup update"
}
